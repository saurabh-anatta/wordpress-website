{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "navy", "name": "Navy", "color": "#0F2A4F" },
        { "slug": "ocean", "name": "Ocean", "color": "#2B74B8" },
        { "slug": "sky", "name": "Sky", "color": "#4A9FDF" },
        { "slug": "gold", "name": "Gold", "color": "#F7B740" },
        { "slug": "ink", "name": "Ink", "color": "#10213A" },
        { "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
        { "slug": "mist", "name": "Mist", "color": "#F4F7FB" }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1600px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "Tiny", "size": "12px" },
        { "slug": "30", "name": "Small", "size": "24px" },
        { "slug": "40", "name": "Medium", "size": "36px" },
        { "slug": "50", "name": "Large", "size": "48px" },
        { "slug": "60", "name": "X-Large", "size": "72px" },
        { "slug": "70", "name": "2X-Large", "size": "96px" },
        { "slug": "80", "name": "3X-Large", "size": "144px" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "nunito-sans",
          "name": "Nunito Sans",
          "fontFamily": "'Nunito Sans', Manrope, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": false },
        { "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
        { "slug": "x-large", "name": "Extra Large", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
        { "slug": "xx-large", "name": "Extra Extra Large", "size": "4rem", "fluid": { "min": "2.75rem", "max": "4rem" } }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|surface",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|nunito-sans",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|nunito-sans",
          "fontWeight": "600"
        },
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "h1": { "typography": { "fontWeight": "700", "lineHeight": "1.05" } },
      "h2": { "typography": { "fontWeight": "600", "lineHeight": "1.15" } },
      "h3": { "typography": { "fontWeight": "600" } },
      "h4": { "typography": { "fontWeight": "600" } },
      "h5": { "typography": { "fontWeight": "600" } },
      "h6": { "typography": { "fontWeight": "600" } },
      "link": {
        "color": {
          "text": "var:preset|color|sky"
        }
      },
      "button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "var:preset|color|navy",
          "text": "var:preset|color|surface"
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    }
  }
}
